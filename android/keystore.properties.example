# Copy to keystore.properties (ignored by git) for signed release builds,
# or set RUBIYOMI_KEYSTORE, RUBIYOMI_KEYSTORE_PASSWORD, RUBIYOMI_KEY_ALIAS
# and RUBIYOMI_KEY_PASSWORD instead. Keep the key itself outside the repository.
#
# Make one with:
#   keytool -genkeypair -v -keystore ~/keys/rubiyomi-upload.jks -alias upload \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=/home/you/keys/rubiyomi-upload.jks
storePassword=
keyAlias=upload
keyPassword=
